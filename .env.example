# ---- PostgreSQL ----
POSTGRES_DB=local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ---- Backend (Spring Boot) ----
# These are consumed by application.yml
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_URL=jdbc:postgresql://postgres:5432/local
# create-drop | create | update | validate | none
DB_JPA_DDL_AUTO=update
BACKEND_PORT=8080

# ---- Frontend (Angular served by nginx) ----
FRONTEND_PORT=4200

# ---- Observability (docker compose --profile monitoring) ----
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_PASSWORD=admin
